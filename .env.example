# انسخ هذا الملف إلى .env وعدّل القيم
NODE_ENV=development
PORT=3000
# رابط الموقع العام (مهم لروابط الرجوع من بوابة الدفع)
BASE_URL=http://localhost:3000

# مفاتيح سرية — ولّد قيمة عشوائية طويلة: openssl rand -hex 32
SESSION_SECRET=
ADMIN_PASSWORD=

CLINIC_TIMEZONE=Asia/Hebron
DEFAULT_COUNTRY_CODE=970
# أرقام الجوال المسموح لها بالحجز (افتراضياً جوال 059 وأوريدو 056). اتركها فارغة للسماح بأي رقم.
ALLOWED_PHONE_PREFIXES=+97059,+97056
# ILS = شيكل
CURRENCY=ILS
# مدة حجز الموعد مؤقتاً بانتظار دفع العربون (بالدقائق)
HOLD_MINUTES=30
DB_PATH=./data/siwak.db

# ---------- الرسائل النصية ----------
# console = تطبع الرسائل في الطرفية (للتجربة) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# رقم المرسل أو Alphanumeric Sender ID مثل SIWAK (حسب الدولة)
TWILIO_FROM=
# أو بدلاً من TWILIO_FROM:
TWILIO_MESSAGING_SERVICE_SID=

# ---------- الدفع ----------
# mock = صفحة دفع تجريبية (ممنوعة في الإنتاج) | stripe | tap
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TAP_SECRET_KEY=
